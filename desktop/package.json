{
  "name": "batto-3-in-1",
  "version": "1.12.0",
  "description": "Batto 3-in-1 mit der Originaloberfläche von OBS Tool 2.4.7",
  "main": "electron/suite-entry.cjs",
  "author": "Crazy_Batto",
  "license": "SEE LICENSE IN build/license_de.txt",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "node scripts/restore-app.cjs && electron scripts/prepare-icons.cjs",
    "start": "electron .",
    "predev": "node scripts/restore-app.cjs && electron scripts/prepare-icons.cjs",
    "dev": "electron .",
    "precheck": "node scripts/restore-app.cjs",
    "check": "node scripts/check.cjs",
    "presmoke": "node scripts/restore-app.cjs",
    "smoke": "node scripts/smoke.cjs",
    "pretest:ui": "node scripts/restore-app.cjs",
    "test:ui": "node scripts/ui-contract.cjs",
    "test:core": "node scripts/core21.cjs",
    "test:broadcast": "node scripts/broadcast-regression.cjs",
    "stress": "node scripts/stress.cjs",
    "soak": "node scripts/soak.cjs",
    "soak:quick": "node -e \"process.env.SOAK_MINUTES='1';require('./scripts/soak.cjs')\"",
    "pack:win": "electron-builder --win --x64 --dir --publish never",
    "test:storage": "node scripts/storage-regression.cjs",
    "test:runtime": "node scripts/runtime21.cjs",
    "test:release": "node scripts/release-regression.cjs",
    "test:installer": "node scripts/installer-regression.cjs",
    "test:community": "node scripts/community-regression.cjs",
    "test:chat-extras": "node scripts/chat-extras-regression.cjs",
    "test:touch": "node --test test/touch-deck.test.cjs test/touch-packages.test.cjs test/touch-demand.test.cjs test/touch-audio*.test.cjs",
    "test:jarvis": "node --test test/jarvis-*.test.cjs test/suite-v247.test.cjs test/suite-120.test.cjs test/suite-140.test.cjs test/suite-150.test.cjs",
    "test:widgets": "node --test test/tikfinity-widgets.test.cjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "express": "5.1.0",
    "obs-websocket-js": "5.0.6",
    "qrcode": "1.5.4",
    "ws": "8.18.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "jsqr": "1.4.0"
  },
  "build": {
    "appId": "de.crazybatto.suite",
    "productName": "Batto 3-in-1",
    "artifactName": "Batto-3-in-1-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "README.md",
      "!electron/main.cjs",
      "!src/adapters/axelchat.cjs",
      "!scripts/axelchat-regression.cjs",
      "!electron/qa*.cjs",
      "!electron/normal-fan-renderer-test.cjs",
      "!scripts/**",
      "!test/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/app-icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "license": "build/license_de.txt",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Batto OBS Tool 2.1",
      "runAfterFinish": false,
      "installerHeader": "src/assets/installer-header.bmp",
      "installerSidebar": "src/assets/installer-sidebar.bmp",
      "uninstallerSidebar": "src/assets/installer-sidebar.bmp",
      "installerIcon": "src/assets/installer.ico",
      "uninstallerIcon": "src/assets/installer.ico"
    },
    "asarUnpack": [
      "src/core/mouse-input.exe",
      "src/core/physical-input.exe"
    ],
    "extraResources": [
      {
        "from": "../VirtualCam",
        "to": "VirtualCam"
      },
      {
        "from": "vendor/piper",
        "to": "piper"
      },
      {
        "from": "../FanAtlas",
        "to": "FanAtlas",
        "filter": [
          "**/*",
          "!**/obs-nvenc-test.exe",
          "!**/obs-amf-test.exe",
          "!**/obs-qsv-test.exe",
          "!**/obs-ffmpeg-mux.exe"
        ]
      },
      {
        "from": "../jarvis",
        "to": "jarvis",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../dist/Extras",
        "to": "Extras"
      },
      {
        "from": "src/assets/app-icon.ico",
        "to": "app-icon.ico"
      },
      {
        "filter": [
          "dist/**",
          "server/**",
          "native/bin/**",
          "native/licenses/**",
          "licenses/**",
          "package.json",
          "native-kingston/bin/PRISM-KingstonCodec.exe",
          "native-lianli/bin/PRISM-LianLi.exe"
        ],
        "to": "PRISM",
        "from": "../PRISM"
      }
    ]
  }
}
