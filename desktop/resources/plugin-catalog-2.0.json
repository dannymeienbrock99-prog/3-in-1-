{
  "schemaVersion": 2,
  "product": "Batto OBS Tool",
  "release": "2.0.0",
  "policy": {
    "showOnlyInstalledExternalPackages": true,
    "nativeFallbacksAreAlwaysAvailable": true,
    "neverReportUnsupportedExecutionAsSuccessful": true,
    "storeTokensEncrypted": true,
    "isolatePluginFailures": true
  },
  "nativeCompatibility": [
    { "id": "batto.obs", "name": "OBS Studio", "legacyVersion": "3.0.3.31", "mode": "native", "actions": ["scene", "source", "mute", "stream", "record", "virtual-camera"] },
    { "id": "batto.discord", "name": "Discord", "legacyVersion": "2.2.0.98", "mode": "native-plus-detected", "actions": ["open", "hotkey"] },
    { "id": "batto.discord-volume", "name": "Discord Volume Mixer", "legacyVersion": "2.0.1.9", "mode": "native", "actions": ["mute", "volume-up", "volume-down"] },
    { "id": "batto.advanced-launcher", "name": "Advanced Launcher", "legacyVersion": "2.0.1", "mode": "native", "actions": ["launch", "url", "hotkey"] },
    { "id": "batto.icue", "name": "iCUE", "legacyVersion": "1.7.250", "mode": "native-plus-detected", "dependency": "Corsair iCUE" },
    { "id": "batto.bambulab", "name": "BambuLab Printer Monitor", "legacyVersion": "1.0.0.1", "mode": "native-plus-detected", "dependency": "Bambu Studio or printer web interface" },
    { "id": "batto.spotify", "name": "Spotify", "legacyVersion": "2.0.2.32", "mode": "native-media-keys" },
    { "id": "batto.volume", "name": "Volume Controller", "legacyVersion": "2.0.3.187", "mode": "native" },
    { "id": "batto.tikfinity", "name": "TikFinity", "legacyVersion": "1.0.3", "mode": "native-webhook-plus-detected" },
    { "id": "batto.tiktok-live", "name": "TikTok LIVE Studio", "legacyVersion": "1.1.5", "mode": "native-launch-plus-webhook" },
    { "id": "batto.twitch-giveaway", "name": "Twitch Giveaway", "legacyVersion": "0.1.1", "mode": "native-overlay" },
    { "id": "batto.youtube-music", "name": "YouTube Music Desktop Connector", "legacyVersion": "2.3", "mode": "native-media-fallback", "dependency": "Optional YouTube Music Desktop App" },
    { "id": "batto.youtube", "name": "YouTube", "legacyVersion": "3.0.1.5", "mode": "native-api", "dependency": "API key for reading; OAuth for write operations" },
    { "id": "batto.youtube-ticker", "name": "YouTube Ticker", "legacyVersion": "2.7.2", "mode": "native-api" },
    { "id": "batto.obsbot", "name": "OBSBOT WebCam", "legacyVersion": "2.2", "mode": "native-hotkeys-plus-detected", "dependency": "OBSBOT Center" },
    { "id": "batto.polls-wheel", "name": "Polls, Word Clouds & Spinner Wheels", "legacyVersion": "0.1.0.2", "mode": "native-overlay" }
  ],
  "iconPacks": ["LS25 Buttons", "TS3 Soundboard", "Emergence", "Mana", "Recon", "Shield", "Team Alpha", "OBS Controls"],
  "mobile": {
    "port": 48620,
    "schemes": ["battoobstool://pair", "creatorhub://pair"],
    "transport": ["WLAN", "LAN", "USB tethering", "Bluetooth PAN when provided by Windows"],
    "cloudRequired": false
  },
  "overlays": {
    "streamOverlayPort": 48621,
    "monitoringPort": 17822,
    "hologramPort": 17821,
    "transparent": true
  }
}
