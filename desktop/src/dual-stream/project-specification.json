      "stream_url": null,
      "credential_reference": null
    },
    "twitch": {
      "canvas_id": "twitch_landscape",
      "enabled_in_project": true,
      "start_automatically": false,
      "access_status": "unconfigured",
      "access_route": "account_authorization_or_stream_key",
      "ingest_server_selection": "auto_after_setup",
      "credential_reference": null
    }
  },
  "credentials_policy": {
    "secret_values_in_this_file": false,
