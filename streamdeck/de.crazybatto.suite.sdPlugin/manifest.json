{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Batto 3-in-1",
  "UUID": "de.crazybatto.suite",
  "Author": "Crazy_Batto",
  "Version": "1.0.0.0",
  "Description": "Jarvis, PC-Messwerte, Lüfter und Kurvenentwürfe auf dem Stream Deck.",
  "Category": "Batto 3-in-1",
  "CategoryIcon": "images/category",
  "Icon": "images/plugin",
  "URL": "https://github.com/dannymeienbrock99-prog/3-in-1-",
  "CodePath": "bin/FanAtlas.Deck.exe",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "de.crazybatto.suite.fan",
      "Name": "Lüfter anzeigen",
      "Tooltip": "Lüfterbild, Temperatur und Drehzahl. Tastendruck wechselt den großen Wert.",
      "Icon": "images/action",
      "PropertyInspectorPath": "ui/index.html",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "de.crazybatto.suite.curve",
      "Name": "Kurvenentwurf wählen",
      "Tooltip": "Wählt einen Entwurf in FanAtlas. Für echte Lüftersteuerung die offizielle iCUE-Aktion verwenden.",
      "Icon": "images/action",
      "PropertyInspectorPath": "ui/index.html",
      "SupportedInMultiActions": true,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "de.crazybatto.suite.sensor",
      "Name": "PC-Messwert anzeigen",
      "Tooltip": "Jeden verfügbaren PC-Messwert auf einer Taste anzeigen; Druck liest den Wert vor.",
      "Icon": "images/action",
      "PropertyInspectorPath": "ui/index.html",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "de.crazybatto.suite.command",
      "Name": "Jarvis Befehl",
      "Tooltip": "Zum Beispiel Pause, GPU Temperatur oder CPU Auslastung. OBS-Szenen werden in Batto 3-in-1 zugeordnet.",
      "Icon": "images/action",
      "PropertyInspectorPath": "ui/index.html",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/key",
          "ShowTitle": false
        }
      ]
    }
  ]
}